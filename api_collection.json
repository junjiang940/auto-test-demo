{
	"info": {
		"_postman_id": "e898fd3c-6e96-4025-8149-40f9f9d7f692",
		"name": "语音转写V3.7接口集合",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "接口登录",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"登录成功 result=0\",function(){\r",
							"    let json=pm.response.json();\r",
							"    pm.expect(json.result).eql(0);\r",
							"})\r",
							"let token=pm.response.json().data.Token;\r",
							"pm.environment.set(\"token\",token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "noauth"
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"Name\": \"{{adminName}}\",\r\n    \"Password\": \"{{adminPwd}}\",\r\n    \"OrgPassword\": \"{{orgPwd}}\",\r\n    \"Version\": \"TS-8661R-V1.0.2\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/itc/user/login",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"itc",
						"user",
						"login"
					]
				}
			},
			"response": []
		},
		{
			"name": "获取会议接口",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// 1. 业务状态校验，等同于JMeter响应断言 \"result\":0\r",
							"pm.test(\"接口执行成功 result=0\", function () {\r",
							"    let res = pm.response.json();\r",
							"    pm.expect(res.result).to.equal(0);\r",
							"});\r",
							"\r",
							"// 2. 提取第一条会议ID，存入环境变量 meetingId，对应JMeter JSON提取器\r",
							"let resData = pm.response.json();\r",
							"if (resData.data?.Rows && resData.data.Rows.length > 0) {\r",
							"    pm.environment.set(\"meetingId\", resData.data.Rows[0].Id);\r",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "default"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/itc/meeting/list?page=1&pagesize=10&mode=1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"itc",
						"meeting",
						"list"
					],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "pagesize",
							"value": "10"
						},
						{
							"key": "mode",
							"value": "1"
						}
					]
				}
			},
			"response": []
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	]
}